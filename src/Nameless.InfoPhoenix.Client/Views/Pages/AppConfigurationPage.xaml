<Page x:Class="Nameless.InfoPhoenix.Client.Views.Pages.AppConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:loc="clr-namespace:Nameless.Windows.Localization;assembly=Nameless.Windows"

      x:Name="AppConfigurationPageRoot"

      mc:Ignorable="d"

      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24">
        <ui:TextBlock FontTypography="Title"
                      Margin="0 0 0 20"
                      Text="{loc:Translator UI_TextBlock_Settings}" />

        <ui:CardControl Name="AppVersionCard"
                        Icon="{ui:ImageIcon 'pack://application:,,,/Nameless.InfoPhoenix.Client;component/Resources/imgs/application_64x64.png'}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Text="{loc:Translator UI_TextBlock_Version}" />
                        <ui:Badge Name="CheckForUpdateBadge"
                                  Appearance="Info"
                                  Content="{loc:Translator UI_Badge_ComingSoon}"
                                  Margin="8 0 0 0"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Name="AppVersionTextBlock"
                               Text="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.AppVersion, Mode=OneTime}" />
                </Grid>
            </ui:CardControl.Header>
            <ui:Button Name="CheckForUpdateButton"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Globe32}"
                       Content="{loc:Translator UI_Button_CheckForUpdate}"
                       Padding="30 8"
                       IsEnabled="False"
                       ToolTip="{loc:Translator UI_ToolTip_NotAvailableYet}"
                       ToolTipService.ShowOnDisabled="True" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage28}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_Language}" />
                    <ui:TextBlock Grid.Row="1" Text="{loc:Translator UI_TextBlock_ChooseLanguage}" />
                </Grid>
            </ui:CardControl.Header>
            <ComboBox Cursor="Hand"
                      ItemsSource="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.AvailableLanguages, Mode=OneTime}"
                      SelectedValue="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.CurrentLanguage, Mode=TwoWay}"
                      IsSynchronizedWithCurrentItem="True"
                      MinWidth="200" />
        </ui:CardControl>

        <ui:CardControl Name="ApplicationBackupCard"
                        Icon="{ui:SymbolIcon DatabaseMultiple20}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_Backup}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_CreateBackup}" />
                </Grid>
            </ui:CardControl.Header>
            <ui:Button Name="ApplicationBackupButton"
                       Appearance="Success"
                       Cursor="Hand"
                       Command="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.PerformApplicationBackupCommand, Mode=OneTime}"
                       Icon="{ui:SymbolIcon DatabaseArrowDown20}"
                       Content="{loc:Translator UI_Button_CreateBackup}"
                       Padding="30 8" />
        </ui:CardControl>

        <ui:CardControl Name="ApplicationRestoreCard"
                        Icon="{ui:SymbolIcon DatabaseLightning20}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_Restore}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_RestoreFromBackup}" />
                </Grid>
            </ui:CardControl.Header>
            <ui:Button Name="ApplicationRestoreButton"
                       Appearance="Success"
                       Cursor="Hand"
                       Command="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.PerformApplicationRestoreCommand, Mode=OneTime}"
                       Icon="{ui:SymbolIcon DatabaseArrowUp20}"
                       Content="{loc:Translator UI_Button_RestoreBackup}"
                       Padding="30 8" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Color24}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_Theme}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_ChooseTheme}" />
                </Grid>
            </ui:CardControl.Header>
            <ComboBox Cursor="Hand"
                      ItemsSource="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.AvailableThemes, Mode=OneTime}"
                      SelectedValue="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.CurrentTheme, Mode=TwoWay}"
                      IsSynchronizedWithCurrentItem="True"
                      MinWidth="200" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_ConfirmBeforeExit}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_AskBeforeExit}" />
                </Grid>
            </ui:CardControl.Header>
            <CheckBox Cursor="Hand"
                      IsChecked="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.CurrentConfirmBeforeExit, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon FolderGlobe20}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_ApplicationDataDirectory}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_OpenDataDirectory}" />
                </Grid>
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary"
                       Cursor="Hand"
                       Command="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.OpenApplicationDataDirectoryCommand, Mode=OneTime}"
                       Content="{loc:Translator UI_Button_OpenDirectory}"
                       Icon="{ui:SymbolIcon Open48}"
                       Padding="30 8" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon CodeTextEdit20}"
                        Margin="0 0 0 10">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Grid.Row="0"
                                  Text="{loc:Translator UI_TextBlock_ApplicationLog}" />
                    <ui:TextBlock Grid.Row="1"
                                  Text="{loc:Translator UI_TextBlock_OpenLogFile}" />
                </Grid>
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary"
                       Cursor="Hand"
                       Command="{Binding ElementName=AppConfigurationPageRoot, Path=ViewModel.OpenApplicationLogFileCommand, Mode=OneTime}"
                       Content="{loc:Translator UI_Button_OpenLogFile}"
                       Icon="{ui:SymbolIcon Open48}"
                       Padding="30 8" />
        </ui:CardControl>
    </StackPanel>
</Page>
