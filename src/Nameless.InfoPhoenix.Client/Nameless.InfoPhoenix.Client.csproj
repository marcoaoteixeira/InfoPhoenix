<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>InfoPhoenix</AssemblyName>
		<ApplicationIcon>application.ico</ApplicationIcon>
		<OutputType>WinExe</OutputType>
		<StartupObject>Nameless.InfoPhoenix.Client.App</StartupObject>
		<ApplicationManifest>App.manifest</ApplicationManifest>

		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\files\docx_file.png" />
	  <None Remove="Resources\files\doc_file.png" />
	  <None Remove="Resources\files\pdf_file.png" />
	  <None Remove="Resources\files\rtf_file.png" />
	  <None Remove="Resources\files\txt_file.png" />
	  <None Remove="Resources\files\xps_file.png" />
	</ItemGroup>

	<!-- Resources -->
	<ItemGroup>
		<Resource Include="Resources\AlteHaasGroteskBold.ttf" />
		<Resource Include="Resources\application_64x64.png" />
		<Resource Include="Resources\loading_64x64.png" />
		<Resource Include="Resources\splash_screen_256x256.png" />
		<Resource Include="Resources\ValidationResourceDictionary.xaml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:Compile</Generator>
		</Resource>
	</ItemGroup>

	<!-- Splash Screen -->

	<!-- Output Folder Files -->
	<ItemGroup>
		<Content Include="AppSettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="application.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\docx_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\doc_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\pdf_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\rtf_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\txt_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\files\xps_file.png">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Nameless.Mediator" />
		<PackageReference Include="Nameless.Validation.FluentValidation" />
		<PackageReference Include="NLog.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nameless.InfoPhoenix.Core\Nameless.InfoPhoenix.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
		<Compile Update="Resources\Validations.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Validations.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Validations.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Validations.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Internals\" />
	</ItemGroup>

</Project>
